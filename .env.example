# Groq API key — get a free one at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Secret for signing JWT tokens — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Default AI model key: gpt-oss (best quality) or scout (fastest)
GROQ_MODEL=gpt-oss

# Optional: full database URL (defaults to local SQLite ./landing_studio.db)
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname
