# Groq API key — get a free one at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Secret for signing JWT tokens — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Optional: where the SQLite database file lives (defaults to ./landing_studio.db)
# DATABASE_PATH=/var/data/landing_studio.db
